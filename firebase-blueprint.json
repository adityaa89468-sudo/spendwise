{
  "entities": {
    "UserProfile": {
      "title": "SpendWise User Profile",
      "description": "User profile with roommate score, streaks, and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roommateScore": { "type": "number", "default": 100 },
        "streak": { "type": "number", "default": 0 },
        "currentGroupId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "upiId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Group": {
      "title": "Room or Group",
      "description": "A roommate split expense group, room, or flat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "adminId": { "type": "string" },
        "members": {
          "type": "array",
          "description": "Embedded list of members for easy reading"
        },
        "inventory": {
          "type": "array",
          "description": "Shared room inventory checklist"
        },
        "tasks": {
          "type": "array",
          "description": "Shared roommate chore tasks list"
        },
        "wishlist": {
          "type": "array",
          "description": "Shared wishlist for room item requests"
        },
        "eventFunds": {
          "type": "array",
          "description": "Shared fund pool tracker (e.g. Birthday, Party)"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code", "adminId", "createdAt"]
    },
    "Expense": {
      "title": "Room Split Expense",
      "description": "A payment made by a member to be split among roommates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "payerId": { "type": "string" },
        "payerName": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "splitType": { "type": "string", "enum": ["equal", "percentage", "selected"] },
        "splits": { "type": "array" },
        "receiptUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "amount", "payerId", "category", "date", "splitType", "splits", "createdAt"]
    },
    "Settlement": {
      "title": "Debt Settlement Record",
      "description": "A record of debt settlement payments checkouts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "toId": { "type": "string" },
        "toName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "settled"] },
        "proofUrl": { "type": "string" },
        "upiTxnId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "fromId", "toId", "status", "createdAt"]
    },
    "AppNotification": {
      "title": "Room Notification",
      "description": "Activity feed alert notifications for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "toUid": { "type": "string" },
        "fromName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "settlement", "room"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean", "default": false }
      },
      "required": ["id", "groupId", "toUid", "text", "type", "createdAt", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User specific profile metadata"
    },
    "/groups/{groupId}": {
      "schema": "Group",
      "description": "Room split group documents"
    },
    "/groups/{groupId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expenses under a specific flat group"
    },
    "/groups/{groupId}/settlements/{settlementId}": {
      "schema": "Settlement",
      "description": "Settlements record for roommate reconciliation"
    },
    "/groups/{groupId}/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Activity feed notifications for group members"
    }
  }
}
